        {"name":"AUTH","class_name":"IdentityRegistry"},{"name":"GOVERNANCE","class_name":"GovernanceStore"},{"name":"CHAIN","class_name":"ChainJourney"},{"name":"COMMUNITY","class_name":"CommunityLedger"}
      ]},
      "vars": {"APP_ENV":"production","AUTH_DOMAIN":"safety-guard-htn2026.klavander56.chatgpt.site","SITE_ORIGIN":"https://safety-guard-htn2026.klavander56.chatgpt.site","ALLOWED_ORIGINS":"https://safety-guard-htn2026.klavander56.chatgpt.site","SOLANA_NETWORK":"devnet","COMMUNITY_ENABLED":"true","COMMUNITY_PROGRAM_ID":"7vuz78V9Tu53Bpt3iXHc37VSDBmRSYxcEguWewR9LXzm","SOLANA_V2_PROGRAM_ID":"23f7UAfNbQCGdfQbJV3Tois98dETDfXnAXgjE5qTH5gb","SOLANA_PROGRAM_ID":"","SOLANA_RPC_URL":"https://api.devnet.solana.com","RESTORE_ALLOWED":"false","OPENAI_ENABLED":"false","OPENAI_MODEL":"gpt-4.1-mini","NOTIFICATIONS_ENABLED":"false","ELEVENLABS_VOICE_ID":"JBFqnCBsd6RMkjVDRZzb"}
